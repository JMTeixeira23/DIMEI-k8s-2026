# versions.env — the single source of truth for every third-party version this
# project installs.
#
# Sourced by bootstrap-aws.sh, bootstrap-azure.sh and scripts/set-failure-policy.sh.
# The workflows apply their own pins; scripts/version-audit.sh checks all of them
# against what upstream currently publishes, and scripts/bump-versions.sh moves
# them forward in one place.
#
# ─────────────────────────────────────────────────────────────────────────────
# TWO SETS OF NUMBERS, AND THE DIFFERENCE MATTERS
#
#   INSTALL_*   what the next bootstrap will install.
#   RESULTS_*   what the artefacts committed under results/ were collected on.
#
# When they differ, results/ describes a cluster that no longer exists. That is
# a legitimate state to be in — it is where this repository sits right now,
# deliberately — but it must be visible, so the bootstraps print a banner and
# scripts/version-audit.sh reports it.
#
# Move RESULTS_* forward only after the affected experiments have actually been
# re-run and their artefacts committed. Never as part of the same edit that
# moves INSTALL_*.
# ─────────────────────────────────────────────────────────────────────────────

# ── What the next bootstrap installs ─────────────────────────────────────────
# Updated 2026-08-02 to the current releases, by decision: the next destroy/apply
# rebuilds on the latest of everything.
#
# Chart version and application version are different numbers, and the
# dissertation must name the application one (defect D12).
KYVERNO_CHART_VERSION="3.8.2"
KYVERNO_APP_VERSION="v1.18.2"

# Cosign 3.x is a MAJOR version change from the 2.2.3 the evaluation used. The
# first pipeline run after this upgrade must confirm that Kyverno can still
# verify what Cosign produces — see the note in scripts/version-audit.sh.
COSIGN_VERSION="v3.1.2"
SYFT_VERSION="v1.50.0"

# Harness only — stages the E3 attestation-replay case. Nothing verifies it and
# no result depends on its version.
CRANE_VERSION="v0.21.8"

# Kubernetes is left where it is: the EKS nodes already run v1.34.x, which is
# current. Recorded so the audit can report it rather than leaving it implicit.
K8S_EXPECTED_MINOR="1.34"

# ── What the committed results describe ──────────────────────────────────────
# Every artefact under results/ was collected against this stack. Each artefact
# also records its own run.kyverno_image, so any single result can be checked
# against this line.
#
# DO NOT move these until the experiments have been re-run on the new stack.
RESULTS_KYVERNO_CHART="3.1.4"
RESULTS_KYVERNO_APP="v1.11.4"
RESULTS_COSIGN="v2.2.3"
RESULTS_SYFT="v0.105.1"
