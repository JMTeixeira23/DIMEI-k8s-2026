# versions.env — the single source of truth for every third-party version this
# evaluation depends on.
#
# Sourced by bootstrap-aws.sh, bootstrap-azure.sh and scripts/set-failure-policy.sh.
# It exists because the Kyverno version was previously written out in three
# places, and three copies of a number are three chances to rebuild a cluster
# onto a version different from the one its results were collected on — silently,
# and without any artefact recording that it happened.
#
# ─────────────────────────────────────────────────────────────────────────────
# THESE VERSIONS ARE PART OF THE RESULT, NOT AN IMPLEMENTATION DETAIL.
#
# Kyverno enforces the policies. Cosign produces the signatures and Syft the
# SBOMs that Kyverno then verifies. Every number in Chapter 6 is a measurement
# *of this stack*. Changing any of them means re-running every experiment that
# depends on it, on every cloud, or the results are not comparable with each
# other and the two-cloud comparison is worse than no comparison at all.
#
# To change one deliberately: edit it here, set ALLOW_VERSION_DRIFT=1 for the
# bootstrap run, and re-run the affected experiments. The guard is not there to
# stop you — it is there to stop it happening by accident.
#
# `bash scripts/version-audit.sh` prints these against what upstream currently
# publishes, and says what changing each one would cost.
# ─────────────────────────────────────────────────────────────────────────────

# Kyverno Helm chart version. Chart 3.1.4 installs application v1.11.4 — the
# chart version and the application version are different numbers and the
# dissertation must name the application one (defect D12).
KYVERNO_CHART_VERSION="3.1.4"
KYVERNO_APP_VERSION="v1.11.4"

# The stack the committed results in results/ were collected on. The bootstrap
# compares KYVERNO_CHART_VERSION against this and refuses to proceed silently if
# they differ, so a cluster can never be quietly rebuilt onto a version the
# evidence does not describe.
EVALUATED_KYVERNO_CHART="3.1.4"

# Signing and SBOM tooling, pinned in the workflows. Recorded here so one file
# answers "what was this evaluated with"; the workflows remain the place the
# pins are applied.
COSIGN_VERSION="v2.2.3"
SYFT_VERSION="v0.105.1"

# Harness only — stages the E3 attestation-replay case. Nothing verifies it and
# no result depends on its version.
CRANE_VERSION="v0.21.8"
